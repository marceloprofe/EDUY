rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function estaAutenticado() {
      return request.auth != null;
    }

    function esEstudiante() {
      return estaAutenticado()
        && get(
          /databases/$(database)/documents/usuarios/$(request.auth.uid)
        ).data.rol == "estudiante";
    }

    function esDocente() {
      return estaAutenticado()
        && get(
          /databases/$(database)/documents/usuarios/$(request.auth.uid)
        ).data.rol == "docente";
    }

    function esAdmin() {
      return estaAutenticado()
        && get(
          /databases/$(database)/documents/usuarios/$(request.auth.uid)
        ).data.rol == "admin";
    }

    match /usuarios/{userId} {

      allow read: if estaAutenticado()
                  && (
                    request.auth.uid == userId
                    || esAdmin()
                  );

      allow create: if estaAutenticado()
                    && request.auth.uid == userId
                    && request.resource.data.rol == "estudiante";

      allow update: if estaAutenticado()
                    && request.auth.uid == userId
                    && request.resource.data.rol
                       == resource.data.rol;

      allow update: if esAdmin()
                    && request.auth.uid != userId
                    && resource.data.rol != "admin"
                    && request.resource.data.rol
                       in ["estudiante", "docente"]
                    && request.resource.data
                       .diff(resource.data)
                       .affectedKeys()
                       .hasOnly([
                         "rol",
                         "fechaActualizacion",
                         "actualizadoPor"
                       ])
                    && request.resource.data.actualizadoPor
                       == request.auth.uid;
    }

    match /cursos/{cursoId} {

      allow read: if resource.data.habilitado == true
                  || (
                    esDocente()
                    && resource.data.docenteId
                       == request.auth.uid
                  );

      allow create: if esDocente()
                    && request.resource.data.docenteId
                       == request.auth.uid
                    && request.resource.data.habilitado
                       == false
                    && request.resource.data.estado
                       == "borrador";

      allow update: if esDocente()
                    && resource.data.docenteId
                       == request.auth.uid
                    && request.resource.data.docenteId
                       == request.auth.uid;

      allow delete: if esDocente()
                    && resource.data.docenteId
                       == request.auth.uid;
    }

    match /adquisiciones/{adquisicionId} {

      // Permite comprobar si el estudiante ya adquirió
      // el curso mediante su identificador.
      allow get: if estaAutenticado()
                 && (
                   esAdmin()
                   || adquisicionId.matches(
                     request.auth.uid + "_.*"
                   )
                 );

      // El estudiante solamente puede listar
      // sus propias adquisiciones.
      // El administrador puede consultar todas.
      allow list: if estaAutenticado()
                  && (
                    esAdmin()
                    || resource.data.usuarioId
                       == request.auth.uid
                  );

      allow create: if esEstudiante()
                    && request.resource.data.usuarioId
                       == request.auth.uid
                    && adquisicionId
                       == request.auth.uid
                          + "_"
                          + request.resource.data.cursoId
                    && request.resource.data.estado
                       == "confirmada"
                    && request.resource.data.pagoSimulado
                       == true
                    && request.resource.data.importe
                       in [1200, 1800, 2400]
                    && request.resource.data.fechaAdquisicion
                       == request.time
                    && get(
                      /databases/$(database)/documents/cursos/$(request.resource.data.cursoId)
                    ).data.habilitado == true
                    && request.resource.data
                       .keys()
                       .hasOnly([
                         "usuarioId",
                         "usuarioCorreo",
                         "cursoId",
                         "cursoTitulo",
                         "importe",
                         "estado",
                         "pagoSimulado",
                         "fechaAdquisicion"
                       ]);

      // Una adquisición confirmada no puede
      // modificarse ni eliminarse desde la aplicación.
      allow update, delete: if false;
    }
  }
}