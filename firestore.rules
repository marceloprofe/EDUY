rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function estaAutenticado() {
      return request.auth != null;
    }

    function esEstudiante() {
      return estaAutenticado()
        && get(
          /databases/$(database)/documents/usuarios/$(request.auth.uid)
        ).data.rol == "estudiante";
    }

    function esDocente() {
      return estaAutenticado()
        && get(
          /databases/$(database)/documents/usuarios/$(request.auth.uid)
        ).data.rol == "docente";
    }

    function esAdmin() {
      return estaAutenticado()
        && get(
          /databases/$(database)/documents/usuarios/$(request.auth.uid)
        ).data.rol == "admin";
    }

    function tieneAdquisicionConfirmada(cursoId) {
      return esEstudiante()
        && exists(
          /databases/$(database)/documents/adquisiciones/$(request.auth.uid + "_" + cursoId)
        )
        && get(
          /databases/$(database)/documents/adquisiciones/$(request.auth.uid + "_" + cursoId)
        ).data.estado == "confirmada";
    }

    match /usuarios/{userId} {

      allow read: if estaAutenticado()
                  && (
                    request.auth.uid == userId
                    || esAdmin()
                  );

      allow create: if estaAutenticado()
                    && request.auth.uid == userId
                    && request.resource.data.rol == "estudiante";

      // Un administrador puede crear perfiles con los roles gestionados
      // desde el panel. No puede asignarlos a su propio UID.
      allow create: if esAdmin()
                    && request.auth.uid != userId
                    && request.resource.data.keys().hasAll([
                      "nombre",
                      "correo",
                      "rol",
                      "fechaCreacion",
                      "fechaActualizacion",
                      "actualizadoPor"
                    ])
                    && request.resource.data.keys().hasOnly([
                      "nombre",
                      "correo",
                      "rol",
                      "fechaCreacion",
                      "fechaActualizacion",
                      "actualizadoPor"
                    ])
                    && request.resource.data.nombre is string
                    && request.resource.data.nombre.size() > 0
                    && request.resource.data.nombre.size() <= 80
                    && request.resource.data.correo is string
                    && request.resource.data.correo.size() > 0
                    && request.resource.data.correo.size() <= 254
                    && request.resource.data.rol
                       in ["estudiante", "docente", "admin"]
                    && request.resource.data.fechaCreacion is timestamp
                    && request.resource.data.fechaActualizacion is timestamp
                    && request.resource.data.actualizadoPor
                       == request.auth.uid;

      allow update: if estaAutenticado()
                    && request.auth.uid == userId
                    && request.resource.data.rol
                       == resource.data.rol;

      // Admin puede actualizar el nombre y los tres roles en otros perfiles,
      // sin modificar cuentas que ya tengan rol administrador.
      allow update: if esAdmin()
                    && request.auth.uid != userId
                    && resource.data.rol != "admin"
                    && request.resource.data.rol
                       in ["estudiante", "docente", "admin"]
                    && request.resource.data.nombre is string
                    && request.resource.data.nombre.size() > 0
                    && request.resource.data.nombre.size() <= 80
                    && request.resource.data
                       .diff(resource.data)
                       .affectedKeys()
                       .hasOnly([
                         "nombre",
                         "rol",
                         "fechaActualizacion",
                         "actualizadoPor"
                       ])
                    && request.resource.data.actualizadoPor
                       == request.auth.uid;
    }

    match /cursos/{cursoId} {

      allow get: if esAdmin()
                 || resource.data.habilitado == true
                 || tieneAdquisicionConfirmada(cursoId)
                 || (
                   esDocente()
                   && resource.data.docenteId
                      == request.auth.uid
                 );

      // Firestore evalúa list para getDocs/consultas de colección.
      allow list: if esAdmin()
                  || resource.data.habilitado == true
                  || (
                    esDocente()
                    && resource.data.docenteId
                       == request.auth.uid
                  );

      allow create: if esDocente()
                    && request.resource.data.docenteId
                       == request.auth.uid
                    && request.resource.data.habilitado
                       == false
                    && request.resource.data.estado
                       == "borrador";

      // Los administradores pueden crear cursos institucionales desde el panel.
      allow create: if esAdmin()
                    && request.resource.data.keys().hasAll([
                      "titulo", "descripcion", "nivel", "imagen",
                      "duracion", "precio", "docenteNombre", "habilitado",
                      "estado", "fechaCreacion", "fechaActualizacion",
                      "modulos", "destacado", "orden"
                    ])
                    && request.resource.data.keys().hasOnly([
                      "titulo", "descripcion", "nivel", "imagen",
                      "duracion", "precio", "docenteNombre", "habilitado",
                      "estado", "fechaCreacion", "fechaActualizacion",
                      "modulos", "destacado", "orden"
                    ])
                    && request.resource.data.titulo is string
                    && request.resource.data.titulo.size() > 0
                    && request.resource.data.titulo.size() <= 120
                    && request.resource.data.descripcion is string
                    && request.resource.data.descripcion.size() > 0
                    && request.resource.data.descripcion.size() <= 2000
                    && request.resource.data.nivel
                       in ["basico", "intermedio", "avanzado"]
                    && request.resource.data.imagen is string
                    && request.resource.data.duracion is string
                    && request.resource.data.precio is number
                    && request.resource.data.precio > 0
                    && request.resource.data.docenteNombre == "Equipo EDUY"
                    && request.resource.data.habilitado is bool
                    && request.resource.data.estado
                       == (request.resource.data.habilitado
                           ? "habilitado"
                           : "borrador")
                    && request.resource.data.fechaCreacion is timestamp
                    && request.resource.data.fechaActualizacion is timestamp
                    && request.resource.data.modulos is list
                    && request.resource.data.modulos.size() <= 20
                    && request.resource.data.destacado is bool
                    && request.resource.data.orden is int;

      allow update: if esDocente()
                    && resource.data.docenteId
                       == request.auth.uid
                    && request.resource.data.docenteId
                       == request.auth.uid;

      // El panel puede editar el catálogo y reasignar un curso a un docente.
      allow update: if esAdmin()
                    && request.resource.data.diff(resource.data)
                       .affectedKeys()
                       .hasOnly([
                         "titulo", "descripcion", "nivel", "imagen",
                         "duracion", "precio", "habilitado", "estado",
                         "fechaActualizacion", "modulos", "docenteId",
                         "docenteNombre"
                       ])
                    && request.resource.data.titulo is string
                    && request.resource.data.titulo.size() > 0
                    && request.resource.data.titulo.size() <= 120
                    && request.resource.data.descripcion is string
                    && request.resource.data.descripcion.size() > 0
                    && request.resource.data.descripcion.size() <= 2000
                    && request.resource.data.nivel
                       in ["basico", "intermedio", "avanzado"]
                    && request.resource.data.imagen is string
                    && request.resource.data.duracion is string
                    && request.resource.data.precio is number
                    && request.resource.data.precio > 0
                    && request.resource.data.habilitado is bool
                    && request.resource.data.estado
                       == (request.resource.data.habilitado
                           ? "habilitado"
                           : "borrador")
                    && request.resource.data.fechaActualizacion is timestamp
                    && request.resource.data.modulos is list
                    && request.resource.data.modulos.size() <= 20
                    && request.resource.data.docenteNombre is string
                    && request.resource.data.docenteNombre.size() <= 120
                    && (
                      !request.resource.data.keys().hasAny(["docenteId"])
                      || (
                        request.resource.data.docenteId is string
                        && exists(
                          /databases/$(database)/documents/usuarios/$(request.resource.data.docenteId)
                        )
                        && get(
                          /databases/$(database)/documents/usuarios/$(request.resource.data.docenteId)
                        ).data.rol == "docente"
                      )
                    );

      allow delete: if esAdmin()
                    || (esDocente()
                        && resource.data.docenteId
                           == request.auth.uid);
    }

    match /adquisiciones/{adquisicionId} {

      // Permite comprobar si el estudiante ya adquirió
      // el curso mediante su identificador.
      allow get: if estaAutenticado()
                 && (
                   esAdmin()
                   || adquisicionId.matches(
                     request.auth.uid + "_.*"
                   )
                 );

      // El estudiante solamente puede listar
      // sus propias adquisiciones.
      // El administrador puede consultar todas.
      allow list: if estaAutenticado()
                  && (
                    esAdmin()
                    || resource.data.usuarioId
                       == request.auth.uid
                  );

      allow create: if esEstudiante()
                    && request.resource.data.usuarioId
                       == request.auth.uid
                    && adquisicionId
                       == request.auth.uid
                          + "_"
                          + request.resource.data.cursoId
                    && request.resource.data.estado
                       == "confirmada"
                    && request.resource.data.pagoSimulado
                       == true
                    && request.resource.data.importe
                       in [1200, 1800, 2400]
                    && request.resource.data.fechaAdquisicion
                       == request.time
                    && get(
                      /databases/$(database)/documents/cursos/$(request.resource.data.cursoId)
                    ).data.habilitado == true
                    && request.resource.data
                       .keys()
                       .hasOnly([
                         "usuarioId",
                         "usuarioCorreo",
                         "cursoId",
                         "cursoTitulo",
                         "importe",
                         "estado",
                         "pagoSimulado",
                         "fechaAdquisicion"
                       ]);

      // El panel puede registrar una adquisición manual para un estudiante
      // y un curso existentes. El ID mantiene la clave estudiante_curso.
      allow create: if esAdmin()
                    && request.resource.data.keys().hasAll([
                      "usuarioId", "usuarioCorreo", "cursoId",
                      "cursoTitulo", "importe", "estado",
                      "pagoSimulado", "fechaAdquisicion"
                    ])
                    && request.resource.data.keys().hasOnly([
                      "usuarioId", "usuarioCorreo", "cursoId",
                      "cursoTitulo", "importe", "estado",
                      "pagoSimulado", "fechaAdquisicion"
                    ])
                    && request.resource.data.usuarioId is string
                    && exists(
                      /databases/$(database)/documents/usuarios/$(request.resource.data.usuarioId)
                    )
                    && get(
                      /databases/$(database)/documents/usuarios/$(request.resource.data.usuarioId)
                    ).data.rol == "estudiante"
                    && request.resource.data.cursoId is string
                    && exists(
                      /databases/$(database)/documents/cursos/$(request.resource.data.cursoId)
                    )
                    && adquisicionId
                       == request.resource.data.usuarioId
                          + "_"
                          + request.resource.data.cursoId
                    && request.resource.data.usuarioCorreo is string
                    && request.resource.data.usuarioCorreo.size() <= 254
                    && request.resource.data.cursoTitulo is string
                    && request.resource.data.cursoTitulo.size() > 0
                    && request.resource.data.cursoTitulo.size() <= 120
                    && request.resource.data.importe is number
                    && request.resource.data.importe > 0
                    && request.resource.data.importe <= 1000000
                    && request.resource.data.estado == "confirmada"
                    && request.resource.data.pagoSimulado == true
                    && request.resource.data.fechaAdquisicion == request.time;

      // El administrador puede corregir importe o fecha, sin cambiar
      // estudiante, curso ni el estado de una adquisición confirmada.
      allow update: if esAdmin()
                    && request.resource.data.diff(resource.data)
                       .affectedKeys()
                       .hasOnly(["importe", "fechaAdquisicion"])
                    && request.resource.data.importe is number
                    && request.resource.data.importe > 0
                    && request.resource.data.importe <= 1000000
                    && request.resource.data.fechaAdquisicion is timestamp
                    && request.resource.data.estado == "confirmada"
                    && request.resource.data.pagoSimulado == true;

      // La baja del administrador retira el registro y permite una nueva compra.
      allow delete: if esAdmin();
    }
  }
}
