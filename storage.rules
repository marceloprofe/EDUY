rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    function estaAutenticado() {
      return request.auth != null;
    }

    function perfilActual() {
      return firestore.get(
        /databases/(default)/documents/usuarios/$(request.auth.uid)
      ).data;
    }

    function esAdmin() {
      return estaAutenticado()
        && perfilActual().rol == "admin";
    }

    function esDocentePropietario(cursoId) {
      return estaAutenticado()
        && perfilActual().rol == "docente"
        && firestore.get(
          /databases/(default)/documents/cursos/$(cursoId)
        ).data.docenteId == request.auth.uid;
    }

    function tieneAccesoAlCurso(cursoId) {
      return esAdmin()
        || esDocentePropietario(cursoId)
        || (
          estaAutenticado()
          && perfilActual().rol == "estudiante"
          && firestore.exists(
            /databases/(default)/documents/adquisiciones/$(request.auth.uid + "_" + cursoId)
          )
          && firestore.get(
            /databases/(default)/documents/adquisiciones/$(request.auth.uid + "_" + cursoId)
          ).data.estado == "confirmada"
        );
    }

    match /cursos/{cursoId}/videos/{docenteId}/{archivo} {
      allow read: if tieneAccesoAlCurso(cursoId);

      allow create, update: if esDocentePropietario(cursoId)
                            && docenteId == request.auth.uid
                            && request.resource.size <= 250 * 1024 * 1024
                            && request.resource.contentType.matches(
                              "video/(mp4|webm)"
                            );

      allow delete: if esDocentePropietario(cursoId)
                    && docenteId == request.auth.uid;
    }
  }
}
